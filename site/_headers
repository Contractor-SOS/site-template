# Security headers for every page. Cloudflare Pages reads this file.
# frame-ancestors lets SEED (a Zite app) show this site in a frame. Keep it, and don't add X-Frame-Options.
# The preview site's noindex header is set in Cloudflare, not here, so a merge can't carry it to the live site.
/*
  Content-Security-Policy: frame-ancestors 'self' https://*.zite.so https://*.zite.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
